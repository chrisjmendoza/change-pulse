{
  "name": "change-pulse",
  "displayName": "Change Pulse",
  "description": "Highlights recent edits in the editor, Explorer, and Source Control with live +/− line change counters.",
  "version": "0.1.0",
  "publisher": "plusorminustwo-designs",
  "icon": "images/change-pulse-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisjmendoza/change-pulse.git"
  },
  "homepage": "https://github.com/chrisjmendoza/change-pulse#readme",
  "bugs": {
    "url": "https://github.com/chrisjmendoza/change-pulse/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "scm": [
        {
          "id": "changePulse.activity",
          "name": "Change Pulse",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "changePulse.activity",
        "contents": "Recent file activity appears here, including agent edits to unopened files.\nCounters show net lines added and removed since tracking started or was cleared."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "file-change-flash.clearChanges",
          "when": "view == changePulse.activity",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "file-change-flash.clearChanges",
        "title": "Clear Activity and Reset Counters",
        "icon": "$(clear-all)",
        "category": "Change Pulse"
      },
      {
        "command": "file-change-flash.showSummary",
        "title": "Show Change Summary",
        "category": "Change Pulse"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:host": "npm run compile && node scripts/run-host-tests.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "diff": "8.0.4"
  }
}
